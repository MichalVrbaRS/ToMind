@page "/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@using ToMind.Data
@using ToMind.Services
@inject ToMindDbContext Db
@inject TopBarState TopBar
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Admin</PageTitle>

@if (!_isAuthorized)
{
    <div class="tm-shell">
        <div class="tm-card tm-card-lg">
            <h1 class="tm-card-title">Admin Access</h1>
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger">@_errorMessage</div>
            }
            <EditForm Model="_passwordModel" OnValidSubmit="UnlockAsync" FormName="admin-login">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label class="form-label" for="adminPassword">Password</label>
                    <InputText id="adminPassword" type="password" class="form-control" @bind-Value="_passwordModel.Password" />
                </div>
                <button class="btn btn-primary w-100" type="submit">Enter</button>
            </EditForm>
        </div>
    </div>
}
else
{
    <div class="tm-card tm-admin-import">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">Import</h1>
        </div>
        <div class="tm-import-help text-muted small mb-3">
            <div><strong>Todo:</strong> one line = one item.</div>
            <div><strong>Kanban:</strong> one line = one card, use <code>$$$</code> to split title and description (optional).</div>
            <div><strong>Existing Kanban:</strong> choose a list and provide a project name to add cards as a new project.</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_importErrorMessage))
        {
            <div class="alert alert-danger">@_importErrorMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(_importSuccessMessage))
        {
            <div class="alert alert-success">@_importSuccessMessage</div>
        }
        <div class="mb-3">
            <label class="form-label">Type</label>
            <InputSelect class="form-select" @bind-Value="_importType">
                <option value="@ListType.Todo">Todo List</option>
                <option value="@ListType.Board">Kanban Board</option>
            </InputSelect>
        </div>
        @if (_importType == ListType.Board)
        {
            <div class="form-check mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="_importIntoExisting" />
                <span class="form-check-label">Import into existing Kanban list</span>
            </div>
        }
        @if (_importType == ListType.Board && _importIntoExisting)
        {
            <div class="mb-3">
                <label class="form-label">Existing Kanban list</label>
                <input class="form-control" list="tm-kanban-lists" placeholder="Start typing list name or paste ID"
                       @bind="_importExistingListInput" @bind:event="oninput" />
                <datalist id="tm-kanban-lists">
                    @foreach (var list in _lists.Where(l => l.Type == ListType.Board).OrderBy(l => l.Name))
                    {
                        <option value="@list.Id" label="@list.Name"></option>
                    }
                </datalist>
            </div>
            <div class="mb-3">
                <label class="form-label">Project name</label>
                <input class="form-control" placeholder="Required for existing list" @bind="_importProjectName" />
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">New list name</label>
                <input class="form-control" placeholder="List name" @bind="_importListName" />
            </div>
            @if (_importType == ListType.Board)
            {
                <div class="mb-3">
                    <label class="form-label">Project name (optional)</label>
                    <input class="form-control" placeholder="Optional project name" @bind="_importProjectName" />
                </div>
            }
        }
        <div class="mb-3">
            <label class="form-label">Items</label>
            <InputTextArea class="form-control tm-import-text" @bind-Value="_importText" />
        </div>
        <button class="btn btn-primary" type="button" @onclick="ImportAsync">Import</button>
    </div>

    <div class="tm-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">All Lists</h1>
            <span class="text-muted">@_lists.Count list(s)</span>
        </div>

        @if (_lists.Count == 0)
        {
            <p class="text-muted mb-0">No lists available.</p>
        }
        else
        {
            <div class="tm-admin-list">
                @foreach (var list in _lists)
                {
                    <div class="tm-admin-row">
                        <div>
                            <div class="fw-semibold">@list.Name</div>
                            <div class="tm-list-meta">
                                @GetListTypeName(list.Type) · Created @FormatDate(list.CreatedAtUtc)
                            </div>
                        </div>
                        <div class="tm-admin-actions">
                            <button class="tm-icon-button tm-admin-action" type="button" title="Copy link" @onclick="() => CopyLinkAsync(list)">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M7.5 7A3.5 3.5 0 0 1 11 3.5h5A3.5 3.5 0 0 1 19.5 7v5A3.5 3.5 0 0 1 16 15.5h-5A3.5 3.5 0 0 1 7.5 12v-5Zm-3 5A3.5 3.5 0 0 1 8 8.5h.5V12A2.5 2.5 0 0 0 11 14.5h5v.5A3.5 3.5 0 0 1 12.5 18.5h-5A3.5 3.5 0 0 1 4 15v-3Z"/>
                                </svg>
                            </button>
                            <button class="tm-icon-button tm-admin-action tm-admin-danger" type="button" title="Delete list" @onclick="() => DeleteListAsync(list)">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm1 6h2v9h-2V9Zm4 0h2v9h-2V9ZM7 9h2v9H7V9Z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private const string DefaultAdminPassword = "todoadmin!1";
    private readonly PasswordModel _passwordModel = new();
    private bool _isAuthorized;
    private string? _errorMessage;
    private List<MindList> _lists = new();
    private string? _adminPassword;
    private ListType _importType = ListType.Todo;
    private bool _importIntoExisting;
    private string _importText = string.Empty;
    private string? _importListName;
    private string? _importProjectName;
    private string? _importExistingListInput;
    private string? _importErrorMessage;
    private string? _importSuccessMessage;

    protected override void OnInitialized()
    {
        _adminPassword = Configuration["ToMind:AdminPassword"]
            ?? Configuration["appSettings:ToMind:AdminPassword"]
            ?? Configuration["AdminPassword"]
            ?? Configuration["appSettings:AdminPassword"]
            ?? DefaultAdminPassword;
        TopBar.Set("Admin", false, false);
    }

    private async Task UnlockAsync()
    {
        if (!string.Equals(_passwordModel.Password, _adminPassword, StringComparison.Ordinal))
        {
            _errorMessage = "Incorrect password.";
            return;
        }

        _errorMessage = null;
        _isAuthorized = true;
        await LoadListsAsync();
    }

    private async Task LoadListsAsync()
    {
        await Db.Database.EnsureCreatedAsync();
        await EnsurePeopleSchemaAsync();
        _lists = await Db.Lists
            .OrderByDescending(l => l.CreatedAtUtc)
            .ToListAsync();
    }

    private async Task CopyLinkAsync(MindList list)
    {
        var url = Navigation.ToAbsoluteUri($"/{list.Id}").ToString();
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
    }

    private async Task DeleteListAsync(MindList list)
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Delete '{list.Name}'?");
        if (!confirmed)
        {
            return;
        }

        var todos = Db.TodoItems.Where(t => t.ListId == list.Id);
        var cards = Db.BoardCards.Where(c => c.ListId == list.Id);
        Db.TodoItems.RemoveRange(todos);
        Db.BoardCards.RemoveRange(cards);
        Db.Lists.Remove(list);
        await Db.SaveChangesAsync();
        _lists.Remove(list);
    }

    private static string GetListTypeName(ListType type)
    {
        return type == ListType.Board ? "Kanban" : "Todo";
    }

    private static string FormatDate(DateTime utc)
    {
        return utc.ToLocalTime().ToString("g");
    }

    private async Task ImportAsync()
    {
        _importErrorMessage = null;
        _importSuccessMessage = null;
        var lines = (_importText ?? string.Empty)
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Trim())
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .ToList();

        if (lines.Count == 0)
        {
            _importErrorMessage = "Enter at least one line to import.";
            return;
        }

        await EnsureImportSchemaAsync();

        if (_importType == ListType.Todo)
        {
            if (string.IsNullOrWhiteSpace(_importListName))
            {
                _importErrorMessage = "Enter a name for the new list.";
                return;
            }

            var list = new MindList
            {
                Id = Guid.NewGuid(),
                Name = _importListName.Trim(),
                Type = ListType.Todo,
                CreatedAtUtc = DateTime.UtcNow,
                UpdatedAtUtc = DateTime.UtcNow
            };

            Db.Lists.Add(list);
            var order = 0;
            var added = 0;
            foreach (var line in lines)
            {
                Db.TodoItems.Add(new TodoItem
                {
                    ListId = list.Id,
                    Text = line,
                    SortOrder = order++
                });
                added++;
            }

            await Db.SaveChangesAsync();
            await LoadListsAsync();
            _importSuccessMessage = $"Imported {added} todo item(s) into '{list.Name}'.";
        }
        else
        {
            MindList? list = null;
            string? projectName = null;

            if (_importIntoExisting)
            {
                list = ResolveExistingBoardList();
                if (list is null)
                {
                    _importErrorMessage = "Select an existing Kanban list.";
                    return;
                }

                if (string.IsNullOrWhiteSpace(_importProjectName))
                {
                    _importErrorMessage = "Enter a project name for the existing list.";
                    return;
                }

                projectName = _importProjectName.Trim();
                list.ProjectName = UpsertProject(list.ProjectName, projectName);
                list.UpdatedAtUtc = DateTime.UtcNow;
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_importListName))
                {
                    _importErrorMessage = "Enter a name for the new list.";
                    return;
                }

                projectName = string.IsNullOrWhiteSpace(_importProjectName) ? null : _importProjectName.Trim();
                list = new MindList
                {
                    Id = Guid.NewGuid(),
                    Name = _importListName.Trim(),
                    Type = ListType.Board,
                    ProjectName = string.IsNullOrWhiteSpace(projectName) ? null : UpsertProject(null, projectName),
                    CreatedAtUtc = DateTime.UtcNow,
                    UpdatedAtUtc = DateTime.UtcNow
                };
                Db.Lists.Add(list);
            }

            var order = 0;
            var added = 0;
            foreach (var line in lines)
            {
                var (title, description) = ParseKanbanLine(line);
                if (string.IsNullOrWhiteSpace(title))
                {
                    continue;
                }

                Db.BoardCards.Add(new BoardCard
                {
                    ListId = list.Id,
                    Title = title,
                    Description = description,
                    Column = BoardColumn.ToDo,
                    SortOrder = order++,
                    ProjectName = projectName
                });
                added++;
            }

            await Db.SaveChangesAsync();
            await LoadListsAsync();
            _importSuccessMessage = $"Imported {added} kanban card(s) into '{list.Name}'.";
        }

        _importText = string.Empty;
        _importListName = null;
        _importProjectName = null;
        _importExistingListInput = null;
    }

    private MindList? ResolveExistingBoardList()
    {
        if (string.IsNullOrWhiteSpace(_importExistingListInput))
        {
            return null;
        }

        var input = _importExistingListInput.Trim();
        if (Guid.TryParse(input, out var id))
        {
            return _lists.FirstOrDefault(l => l.Type == ListType.Board && l.Id == id);
        }

        return _lists.FirstOrDefault(l => l.Type == ListType.Board
            && string.Equals(l.Name, input, StringComparison.OrdinalIgnoreCase));
    }

    private static (string title, string? description) ParseKanbanLine(string line)
    {
        var index = line.IndexOf("$$$", StringComparison.Ordinal);
        if (index < 0)
        {
            return (line.Trim(), null);
        }

        var title = line[..index].Trim();
        var description = line[(index + 3)..].Trim();
        return (title, string.IsNullOrWhiteSpace(description) ? null : description);
    }

    private static string? UpsertProject(string? current, string project)
    {
        var list = ParseProjects(current);
        if (!list.Any(p => string.Equals(p, project, StringComparison.OrdinalIgnoreCase)))
        {
            list.Add(project);
        }
        return list.Count == 0 ? null : System.Text.Json.JsonSerializer.Serialize(list);
    }

    private static List<string> ParseProjects(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new List<string>();
        }

        var trimmed = value.Trim();
        if (trimmed.StartsWith("[", StringComparison.Ordinal) && trimmed.EndsWith("]", StringComparison.Ordinal))
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<List<string>>(trimmed) ?? new List<string>();
            return parsed
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Select(p => p.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        return new List<string> { trimmed };
    }

    private async Task EnsurePeopleSchemaAsync()
    {
        var connection = Db.Database.GetDbConnection();
        await connection.OpenAsync();
        try
        {
            await EnsureColumnAsync(connection, "Lists", "PeopleJson");
        }
        finally
        {
            await connection.CloseAsync();
        }
    }

    private async Task EnsureImportSchemaAsync()
    {
        var connection = Db.Database.GetDbConnection();
        await connection.OpenAsync();
        try
        {
            await EnsureColumnAsync(connection, "TodoItems", "ProjectName");
            await EnsureColumnAsync(connection, "BoardCards", "ProjectName");
            await EnsureColumnAsync(connection, "Lists", "ProjectName");
        }
        finally
        {
            await connection.CloseAsync();
        }
    }

    private static async Task EnsureColumnAsync(DbConnection connection, string tableName, string columnName)
    {
        await using var checkCommand = connection.CreateCommand();
        checkCommand.CommandText = $"PRAGMA table_info({tableName});";
        await using var reader = await checkCommand.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            var name = reader.GetString(1);
            if (string.Equals(name, columnName, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }
        }

        await using var alterCommand = connection.CreateCommand();
        alterCommand.CommandText = $"ALTER TABLE {tableName} ADD COLUMN {columnName} TEXT";
        await alterCommand.ExecuteNonQueryAsync();
    }

    private sealed class PasswordModel
    {
        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
