@page "/{ListId:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using ToMind.Data
@using ToMind.Services
@inject ToMindDbContext Db
@inject ListSecurityService Security
@inject ListLocalStorage LocalStorage
@inject NavigationManager Navigation
@inject TopBarState TopBar

<PageTitle>@_pageTitle</PageTitle>

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (_notFound)
{
    <h3>Not Found</h3>
    <p>Sorry, the list you are looking for does not exist.</p>
}
else if (_list is not null)
{
    @if (_requiresPassword && !_isAuthorized)
    {
        <div class="tm-card tm-auth-card">
            <div class="text-center mb-3">
                <div class="tm-lock">🔒</div>
                <h2 class="h5 mb-1">This list is protected</h2>
                <div class="text-muted">Enter the password to continue.</div>
            </div>
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }
                <EditForm Model="_passwordModel" OnValidSubmit="UnlockAsync" FormName="unlock-list">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <InputText id="password" type="password" class="form-control" @bind-Value="_passwordModel.Password" />
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox id="remember" class="form-check-input" @bind-Value="_passwordModel.RememberMe" />
                        <label class="form-check-label" for="remember">Remember me</label>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Submit</button>
                </EditForm>
        </div>
    }
    else
    {
        <div class="tm-project-tabs">
            @foreach (var project in _projects)
            {
                <button class="tm-project-tab @(project == _activeProject ? "is-active" : null)" type="button" @onclick="() => SetActiveProject(project)">
                    @project
                </button>
            }
            <button class="tm-icon-button tm-project-add-button" type="button" title="Add project" @onclick="BeginAddProject">
                +
            </button>
        </div>
        @if (_isAddingProject)
        {
            <div class="tm-project-add">
                @if (!string.IsNullOrWhiteSpace(_projectErrorMessage))
                {
                    <div class="alert alert-danger">@_projectErrorMessage</div>
                }
                <div class="d-flex flex-wrap gap-2">
                    <input class="form-control tm-project-input" placeholder="Project name" @ref="_newProjectInput"
                           @bind="_newProjectName" @bind:event="oninput" @onkeydown="HandleProjectKeyDown" />
                    <button class="btn btn-primary btn-sm" type="button" @onclick="AddProjectAsync">Add</button>
                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CancelAddProject">Cancel</button>
                </div>
            </div>
        }

        <datalist id="tm-people-list">
            @foreach (var person in _people)
            {
                <option value="@person"></option>
            }
        </datalist>

        @if (_list.Type == ListType.Todo)
        {
            var orderedTodos = GetOrderedTodos();
            <div class="tm-card">
                <h2 class="h5">To-do items</h2>
                    @if (!string.IsNullOrWhiteSpace(_todoErrorMessage))
                    {
                        <div class="alert alert-danger">@_todoErrorMessage</div>
                    }
                    <div class="input-group mb-3">
                        <input class="form-control" placeholder="Add item" @bind="_newTodoText" @bind:event="oninput" @onkeydown="HandleTodoKeyDown" />
                        <div class="tm-assignee-combo">
                            <input class="form-control tm-assignee-input" placeholder="Assignee (optional)" list="tm-people-list"
                                   @bind="_newTodoAssignee" @bind:event="oninput" />
                            @if (_people.Count > 0)
                            {
                                <button class="tm-assignee-toggle" type="button" title="Pick assignee" @onclick="() => ToggleAssigneePicker(NewTodoPickerKey)">▾</button>
                                @if (IsAssigneePickerOpen(NewTodoPickerKey))
                                {
                                    <div class="tm-assignee-menu">
                                        @foreach (var person in _people)
                                        {
                                            <button class="tm-assignee-option" type="button" @onclick="() => SelectNewTodoAssignee(person)">@person</button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                        <button class="btn btn-primary" type="button" @onclick="AddTodoAsync">Add</button>
                    </div>

                    @if (orderedTodos.Count == 0)
                    {
                        <p class="text-muted mb-0">No items yet.</p>
                    }
                    else
                    {
                        <ul class="list-group" @ondragover:preventDefault @ondrop="DropTodoToEndAsync">
                            @foreach (var item in orderedTodos)
                            {
                                var checkboxId = $"todo-{item.Id}";
                                var index = orderedTodos.IndexOf(item);
                                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 tm-drag-item"
                                    draggable="true"
                                    @ondragstart="() => StartTodoDrag(item)"
                                    @ondragend="ClearTodoDrag"
                                    @ondragover:preventDefault
                                    @ondrop="() => DropTodoOnItemAsync(item)">
                                    <div class="form-check">
                                        <input id="@checkboxId" class="form-check-input" type="checkbox" checked="@item.IsDone"
                                               @onchange="args => ToggleDoneAsync(item, args)" />
                                        <label class="form-check-label @(item.IsDone ? "text-decoration-line-through text-muted" : null)" for="@checkboxId">
                                            @item.Text
                                        </label>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="tm-assignee-combo">
                                            <input class="form-control form-control-sm tm-assignee-input" placeholder="Assignee"
                                                   list="tm-people-list" value="@item.AssigneeName"
                                                   @onchange="args => UpdateTodoAssigneeAsync(item, args)" />
                                            @if (_people.Count > 0)
                                            {
                                                var todoKey = $"todo-{item.Id}";
                                                <button class="tm-assignee-toggle tm-assignee-toggle-sm" type="button" title="Pick assignee" @onclick="() => ToggleAssigneePicker(todoKey)">▾</button>
                                                @if (IsAssigneePickerOpen(todoKey))
                                                {
                                                    <div class="tm-assignee-menu">
                                                        @foreach (var person in _people)
                                                        {
                                                            <button class="tm-assignee-option" type="button" @onclick="() => SelectTodoAssigneeAsync(item, person)">@person</button>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button class="btn btn-outline-secondary" type="button" @onclick="() => MoveTodoAsync(item, -1)" disabled="@(index <= 0)">
                                                Up
                                            </button>
                                            <button class="btn btn-outline-secondary" type="button" @onclick="() => MoveTodoAsync(item, 1)" disabled="@(index >= orderedTodos.Count - 1)">
                                                Down
                                            </button>
                                            <button class="btn btn-outline-danger" type="button" @onclick="() => DeleteTodoAsync(item)">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
            </div>
        }
        else
        {
            <div class="tm-board">
                @foreach (var column in _boardColumns)
                {
                    var cards = GetOrderedCards(column);
                    <div class="tm-column" @ondragover:preventDefault @ondrop="() => DropCardToColumnEndAsync(column)">
                        <div class="tm-column-header">
                            <span>@GetColumnTitle(column)</span>
                            <button class="tm-icon-button" type="button" title="Add card" @onclick="() => ToggleColumnInput(column)">
                                +
                            </button>
                        </div>
                        @if (_activeColumnInput == column)
                        {
                            <div class="tm-column-input">
                                @if (!string.IsNullOrWhiteSpace(_boardErrorMessage))
                                {
                                    <div class="alert alert-danger">@_boardErrorMessage</div>
                                }
                                <InputText class="form-control" placeholder="Card title" @bind-Value="_newCardTitle" />
                                <InputTextArea class="form-control" placeholder="Description (optional)" @bind-Value="_newCardDescription" />
                                <div class="tm-assignee-combo">
                                    <input class="form-control tm-assignee-input" placeholder="Assignee (optional)"
                                           list="tm-people-list" @bind="_newCardAssignee" @bind:event="oninput" />
                                    @if (_people.Count > 0)
                                    {
                                        var newCardKey = $"new-card-{column}";
                                        <button class="tm-assignee-toggle" type="button" title="Pick assignee" @onclick="() => ToggleAssigneePicker(newCardKey)">▾</button>
                                        @if (IsAssigneePickerOpen(newCardKey))
                                        {
                                            <div class="tm-assignee-menu">
                                                @foreach (var person in _people)
                                                {
                                                    <button class="tm-assignee-option" type="button" @onclick="() => SelectNewCardAssignee(person)">@person</button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary btn-sm" type="button" @onclick="() => AddCardToColumnAsync(column)">Add</button>
                                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ClearColumnInput">Cancel</button>
                                </div>
                            </div>
                        }
                        <div class="tm-column-body" @ondragover:preventDefault @ondrop="() => DropCardToColumnEndAsync(column)">
                            @if (cards.Count == 0)
                            {
                                <div class="text-muted small">No cards.</div>
                            }
                            else
                            {
                                @foreach (var card in cards)
                                {
                                    var isEditing = _editingCardId == card.Id;
                                    <div class="tm-card tm-board-card tm-drag-item @(isEditing ? "tm-editing" : null)"
                                         draggable="@(!isEditing)"
                                         @ondragstart="() => StartCardDrag(card)"
                                         @ondragend="ClearCardDrag"
                                         @ondragover:preventDefault
                                         @ondrop="() => DropCardOnCardAsync(card)">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div class="flex-grow-1">
                                                @if (isEditing)
                                                {
                                                    @if (!string.IsNullOrWhiteSpace(_editCardErrorMessage))
                                                    {
                                                        <div class="alert alert-danger">@_editCardErrorMessage</div>
                                                    }
                                                    <InputText class="form-control mb-2" placeholder="Card title" @bind-Value="_editCardTitle" />
                                                    <InputTextArea class="form-control mb-2" placeholder="Description (optional)" @bind-Value="_editCardDescription" />
                                                    <div class="tm-assignee-combo">
                                                        <input class="form-control mb-2 tm-assignee-input" placeholder="Assignee (optional)"
                                                               list="tm-people-list" @bind="_editCardAssignee" @bind:event="oninput" />
                                                        @if (_people.Count > 0)
                                                        {
                                                            var editKey = $"edit-card-{card.Id}";
                                                            <button class="tm-assignee-toggle" type="button" title="Pick assignee" @onclick="() => ToggleAssigneePicker(editKey)">▾</button>
                                                            @if (IsAssigneePickerOpen(editKey))
                                                            {
                                                                <div class="tm-assignee-menu">
                                                                    @foreach (var person in _people)
                                                                    {
                                                                        <button class="tm-assignee-option" type="button" @onclick="() => SelectEditCardAssignee(person)">@person</button>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                    <div class="d-flex gap-2">
                                                        <button class="btn btn-primary btn-sm" type="button" @onclick="() => SaveCardEditAsync(card)">Save</button>
                                                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CancelCardEdit">Cancel</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="fw-semibold">@card.Title</div>
                                                    @if (!string.IsNullOrWhiteSpace(card.Description))
                                                    {
                                                        <div class="text-muted small">@card.Description</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(card.AssigneeName))
                                                    {
                                                        <div class="tm-assignee">@card.AssigneeName</div>
                                                    }
                                                }
                                            </div>
                                            @if (!isEditing)
                                            {
                                                <div class="d-flex gap-1">
                                                    <button class="tm-icon-button" type="button" title="Edit card" @onclick="() => StartCardEdit(card)">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                                            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25Zm18.71-11.04a1.003 1.003 0 0 0 0-1.42l-2.5-2.5a1.003 1.003 0 0 0-1.42 0L15.13 3.9l3.75 3.75 2.83-2.83Z"/>
                                                        </svg>
                                                    </button>
                                                    <button class="tm-icon-button tm-icon-danger" type="button" title="Delete card" @onclick="() => DeleteCardAsync(card)">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                                            <path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm1 6h2v9h-2V9Zm4 0h2v9h-2V9Z"/>
                                                        </svg>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public Guid ListId { get; set; }

    private MindList? _list;
    private List<TodoItem> _todoItems = new();
    private List<BoardCard> _boardCards = new();
    private readonly BoardColumn[] _boardColumns = Enum.GetValues<BoardColumn>();
    private bool _isLoading = true;
    private bool _notFound;
    private bool _requiresPassword;
    private bool _isAuthorized;
    private string _pageTitle = "List";
    private string? _errorMessage;
    private string? _todoErrorMessage;
    private string _newTodoText = string.Empty;
    private int? _draggedTodoId;
    private int? _draggedCardId;
    private string? _boardErrorMessage;
    private string _newCardTitle = string.Empty;
    private string? _newCardDescription;
    private string? _newCardAssignee;
    private BoardColumn? _activeColumnInput;
    private List<string> _projects = new();
    private string? _activeProject;
    private List<string> _people = new();
    private string? _newTodoAssignee;
    private string? _activeAssigneePicker;
    private const string NewTodoPickerKey = "new-todo";
    private bool _isAddingProject;
    private string _newProjectName = string.Empty;
    private string? _projectErrorMessage;
    private ElementReference _newProjectInput;
    private bool _shouldFocusProjectInput;
    private int? _editingCardId;
    private string _editCardTitle = string.Empty;
    private string? _editCardDescription;
    private string? _editCardAssignee;
    private string? _editCardErrorMessage;
    private readonly PasswordModel _passwordModel = new();

    protected override async Task OnInitializedAsync()
    {
        await Db.Database.EnsureCreatedAsync();
        await EnsureSchemaAsync();
        _list = await Db.Lists
            .Include(l => l.TodoItems)
            .Include(l => l.BoardCards)
            .FirstOrDefaultAsync(l => l.Id == ListId);
        if (_list is null)
        {
            var lastOpened = await LocalStorage.GetLastOpenedListIdAsync();
            if (lastOpened == ListId)
            {
                await LocalStorage.ClearLastOpenedListIdAsync();
                Navigation.NavigateTo("/?new=1");
                return;
            }

            _notFound = true;
            _isLoading = false;
            TopBar.Set("ToMind", false, false);
            return;
        }

        var shareUrl = Navigation.ToAbsoluteUri($"/{ListId}").ToString();
        TopBar.Set(_list.Name, true, true, shareUrl, _list.Description);
        if (_list.Type == ListType.Todo)
        {
            _todoItems = _list.TodoItems
                .OrderBy(i => i.SortOrder)
                .ThenBy(i => i.Id)
                .ToList();
        }
        else
        {
            _boardCards = _list.BoardCards
                .OrderBy(c => c.SortOrder)
                .ThenBy(c => c.Id)
                .ToList();
        }

        await InitializeProjectsAsync();
        await InitializePeopleAsync();

        _pageTitle = _list.Name;
        _requiresPassword = !string.IsNullOrWhiteSpace(_list.PasswordHash);
        if (!_requiresPassword)
        {
            _isAuthorized = true;
        }

        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_list is null)
        {
            return;
        }

        if (firstRender && _requiresPassword && !_isAuthorized)
        {
            var token = await LocalStorage.GetRememberMeTokenAsync(_list.Id);
            if (!string.IsNullOrWhiteSpace(token)
                && Security.VerifyRememberMeToken(_list, _list.RememberMeTokenHash, token))
            {
                _isAuthorized = true;
                await LocalStorage.SetLastOpenedListIdAsync(_list.Id);
                StateHasChanged();
            }
            else if (!string.IsNullOrWhiteSpace(token))
            {
                await LocalStorage.ClearRememberMeTokenAsync(_list.Id);
            }
        }
        else if (firstRender && _isAuthorized)
        {
            await LocalStorage.SetLastOpenedListIdAsync(_list.Id);
        }

        if (_shouldFocusProjectInput)
        {
            _shouldFocusProjectInput = false;
            await _newProjectInput.FocusAsync();
        }
    }

    private async Task UnlockAsync()
    {
        if (_list is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_passwordModel.Password))
        {
            _errorMessage = "Password is required.";
            return;
        }

        if (!Security.VerifyPassword(_list, _list.PasswordHash, _passwordModel.Password))
        {
            _errorMessage = "Incorrect password.";
            return;
        }

        _errorMessage = null;
        _isAuthorized = true;

        if (_passwordModel.RememberMe)
        {
            var token = Security.CreateRememberMeToken(_list);
            _list.RememberMeTokenHash = token.TokenHash;
            await Db.SaveChangesAsync();
            await LocalStorage.SetRememberMeTokenAsync(_list.Id, token.Token);
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(_list.RememberMeTokenHash))
            {
                _list.RememberMeTokenHash = null;
                await Db.SaveChangesAsync();
            }
            await LocalStorage.ClearRememberMeTokenAsync(_list.Id);
        }

        await LocalStorage.SetLastOpenedListIdAsync(_list.Id);
    }

    private List<TodoItem> GetOrderedTodos()
    {
        return _todoItems
            .Where(i => MatchesActiveProject(i.ProjectName))
            .OrderBy(i => i.SortOrder)
            .ThenBy(i => i.Id)
            .ToList();
    }

    private List<BoardCard> GetOrderedCards(BoardColumn column)
    {
        return _boardCards
            .Where(c => c.Column == column && MatchesActiveProject(c.ProjectName))
            .OrderBy(c => c.SortOrder)
            .ThenBy(c => c.Id)
            .ToList();
    }

    private async Task HandleTodoKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddTodoAsync();
        }
    }

    private async Task AddTodoAsync()
    {
        if (_list is null || _list.Type != ListType.Todo)
        {
            return;
        }

        var text = _newTodoText.Trim();
        if (string.IsNullOrWhiteSpace(text))
        {
            _todoErrorMessage = "Enter a to-do item.";
            return;
        }

        _todoErrorMessage = null;
        var nextOrder = GetOrderedTodos()
            .Select(i => i.SortOrder)
            .DefaultIfEmpty(-1)
            .Max() + 1;
        var assignee = NormalizeAssignee(_newTodoAssignee);
        await AddPersonIfNewAsync(assignee);
        var item = new TodoItem
        {
            ListId = _list.Id,
            Text = text,
            ProjectName = _activeProject,
            AssigneeName = assignee,
            IsDone = false,
            SortOrder = nextOrder
        };
        Db.TodoItems.Add(item);
        await Db.SaveChangesAsync();
        _todoItems.Add(item);
        _newTodoText = string.Empty;
        _newTodoAssignee = null;
        CloseAssigneePicker();
    }

    private void StartTodoDrag(TodoItem item)
    {
        _draggedTodoId = item.Id;
    }

    private void ClearTodoDrag()
    {
        _draggedTodoId = null;
    }

    private async Task DropTodoOnItemAsync(TodoItem target)
    {
        if (_list is null || _list.Type != ListType.Todo || _draggedTodoId is null)
        {
            return;
        }

        var dragged = _todoItems.FirstOrDefault(i => i.Id == _draggedTodoId.Value);
        if (dragged is null || dragged.Id == target.Id)
        {
            return;
        }

        var ordered = GetOrderedTodos();
        ordered.Remove(dragged);
        var targetIndex = ordered.IndexOf(target);
        if (targetIndex < 0)
        {
            targetIndex = ordered.Count;
        }
        ordered.Insert(targetIndex, dragged);
        await NormalizeTodoOrderAsync(ordered);
        _draggedTodoId = null;
    }

    private async Task DropTodoToEndAsync()
    {
        if (_list is null || _list.Type != ListType.Todo || _draggedTodoId is null)
        {
            return;
        }

        var dragged = _todoItems.FirstOrDefault(i => i.Id == _draggedTodoId.Value);
        if (dragged is null)
        {
            return;
        }

        var ordered = GetOrderedTodos();
        ordered.Remove(dragged);
        ordered.Add(dragged);
        await NormalizeTodoOrderAsync(ordered);
        _draggedTodoId = null;
    }

    private async Task ToggleDoneAsync(TodoItem item, ChangeEventArgs args)
    {
        if (_list is null || _list.Type != ListType.Todo)
        {
            return;
        }

        item.IsDone = args.Value switch
        {
            bool value => value,
            string value when bool.TryParse(value, out var parsed) => parsed,
            _ => item.IsDone
        };

        await Db.SaveChangesAsync();
    }

    private async Task UpdateTodoAssigneeAsync(TodoItem item, ChangeEventArgs args)
    {
        await SetTodoAssigneeAsync(item, args.Value?.ToString());
    }

    private async Task SetTodoAssigneeAsync(TodoItem item, string? value)
    {
        if (_list is null || _list.Type != ListType.Todo)
        {
            return;
        }

        var assignee = NormalizeAssignee(value);
        await AddPersonIfNewAsync(assignee);
        item.AssigneeName = assignee;
        await Db.SaveChangesAsync();
    }

    private async Task DeleteTodoAsync(TodoItem item)
    {
        if (_list is null || _list.Type != ListType.Todo)
        {
            return;
        }

        Db.TodoItems.Remove(item);
        _todoItems.Remove(item);
        await Db.SaveChangesAsync();
        await NormalizeTodoOrderAsync();
    }

    private async Task MoveTodoAsync(TodoItem item, int delta)
    {
        if (_list is null || _list.Type != ListType.Todo)
        {
            return;
        }

        var ordered = GetOrderedTodos();
        var index = ordered.IndexOf(item);
        var targetIndex = index + delta;
        if (index < 0 || targetIndex < 0 || targetIndex >= ordered.Count)
        {
            return;
        }

        (ordered[index], ordered[targetIndex]) = (ordered[targetIndex], ordered[index]);
        await NormalizeTodoOrderAsync(ordered);
    }

    private async Task NormalizeTodoOrderAsync(List<TodoItem>? ordered = null)
    {
        var list = ordered ?? GetOrderedTodos();
        for (var i = 0; i < list.Count; i++)
        {
            list[i].SortOrder = i;
        }

        await Db.SaveChangesAsync();
    }

    private static string GetColumnTitle(BoardColumn column)
    {
        return column switch
        {
            BoardColumn.ToDo => "To Do",
            BoardColumn.InProgress => "In Progress",
            BoardColumn.Done => "Done",
            _ => column.ToString()
        };
    }

    private void ToggleColumnInput(BoardColumn column)
    {
        _boardErrorMessage = null;
        _activeColumnInput = _activeColumnInput == column ? null : column;
        _newCardTitle = string.Empty;
        _newCardDescription = null;
        _newCardAssignee = null;
    }

    private void ClearColumnInput()
    {
        _boardErrorMessage = null;
        _activeColumnInput = null;
        _newCardTitle = string.Empty;
        _newCardDescription = null;
        _newCardAssignee = null;
    }

    private async Task AddCardToColumnAsync(BoardColumn column)
    {
        if (_list is null || _list.Type != ListType.Board)
        {
            return;
        }

        var title = _newCardTitle.Trim();
        if (string.IsNullOrWhiteSpace(title))
        {
            _boardErrorMessage = "Enter a card title.";
            return;
        }

        _boardErrorMessage = null;
        var nextOrder = _boardCards
            .Where(c => c.Column == column && MatchesActiveProject(c.ProjectName))
            .Select(c => c.SortOrder)
            .DefaultIfEmpty(-1)
            .Max() + 1;

        var assignee = NormalizeAssignee(_newCardAssignee);
        await AddPersonIfNewAsync(assignee);
        var card = new BoardCard
        {
            ListId = _list.Id,
            Title = title,
            Description = string.IsNullOrWhiteSpace(_newCardDescription) ? null : _newCardDescription.Trim(),
            ProjectName = _activeProject,
            AssigneeName = assignee,
            Column = column,
            SortOrder = nextOrder
        };

        Db.BoardCards.Add(card);
        await Db.SaveChangesAsync();
        _boardCards.Add(card);
        _newCardTitle = string.Empty;
        _newCardDescription = null;
        _newCardAssignee = null;
        _activeColumnInput = null;
        CloseAssigneePicker();
    }

    private void StartCardEdit(BoardCard card)
    {
        _editCardErrorMessage = null;
        _editingCardId = card.Id;
        _editCardTitle = card.Title;
        _editCardDescription = card.Description;
        _editCardAssignee = card.AssigneeName;
    }

    private void CancelCardEdit()
    {
        _editCardErrorMessage = null;
        _editingCardId = null;
        _editCardTitle = string.Empty;
        _editCardDescription = null;
        _editCardAssignee = null;
    }

    private async Task SaveCardEditAsync(BoardCard card)
    {
        if (_list is null || _list.Type != ListType.Board || _editingCardId != card.Id)
        {
            return;
        }

        var title = _editCardTitle.Trim();
        if (string.IsNullOrWhiteSpace(title))
        {
            _editCardErrorMessage = "Enter a card title.";
            return;
        }

        var assignee = NormalizeAssignee(_editCardAssignee);
        await AddPersonIfNewAsync(assignee);
        _editCardErrorMessage = null;
        card.Title = title;
        card.Description = string.IsNullOrWhiteSpace(_editCardDescription) ? null : _editCardDescription.Trim();
        card.AssigneeName = assignee;
        await Db.SaveChangesAsync();
        CancelCardEdit();
        CloseAssigneePicker();
    }

    private void StartCardDrag(BoardCard card)
    {
        _draggedCardId = card.Id;
    }

    private void ClearCardDrag()
    {
        _draggedCardId = null;
    }

    private async Task DropCardOnCardAsync(BoardCard target)
    {
        if (_list is null || _list.Type != ListType.Board || _draggedCardId is null)
        {
            return;
        }

        var dragged = _boardCards.FirstOrDefault(c => c.Id == _draggedCardId.Value);
        if (dragged is null)
        {
            return;
        }

        var sourceColumn = dragged.Column;
        var targetColumn = target.Column;

        if (dragged.Id == target.Id && sourceColumn == targetColumn)
        {
            return;
        }

        if (sourceColumn == targetColumn)
        {
            var ordered = GetOrderedCards(sourceColumn);
            ordered.Remove(dragged);
            var targetIndex = ordered.IndexOf(target);
            if (targetIndex < 0)
            {
                targetIndex = ordered.Count;
            }
            ordered.Insert(targetIndex, dragged);
            UpdateCardSortOrders(ordered);
        }
        else
        {
            var source = GetOrderedCards(sourceColumn);
            source.Remove(dragged);
            var destination = GetOrderedCards(targetColumn);
            var targetIndex = destination.IndexOf(target);
            if (targetIndex < 0)
            {
                targetIndex = destination.Count;
            }
            dragged.Column = targetColumn;
            destination.Insert(targetIndex, dragged);
            UpdateCardSortOrders(source);
            UpdateCardSortOrders(destination);
        }

        await Db.SaveChangesAsync();
        _draggedCardId = null;
    }

    private async Task DropCardToColumnEndAsync(BoardColumn column)
    {
        if (_list is null || _list.Type != ListType.Board || _draggedCardId is null)
        {
            return;
        }

        var dragged = _boardCards.FirstOrDefault(c => c.Id == _draggedCardId.Value);
        if (dragged is null)
        {
            return;
        }

        var sourceColumn = dragged.Column;
        if (sourceColumn == column)
        {
            var ordered = GetOrderedCards(column);
            ordered.Remove(dragged);
            ordered.Add(dragged);
            UpdateCardSortOrders(ordered);
        }
        else
        {
            var source = GetOrderedCards(sourceColumn);
            source.Remove(dragged);
            var destination = GetOrderedCards(column);
            dragged.Column = column;
            destination.Add(dragged);
            UpdateCardSortOrders(source);
            UpdateCardSortOrders(destination);
        }

        await Db.SaveChangesAsync();
        _draggedCardId = null;
    }

    private async Task DeleteCardAsync(BoardCard card)
    {
        if (_list is null || _list.Type != ListType.Board)
        {
            return;
        }

        if (_editingCardId == card.Id)
        {
            CancelCardEdit();
        }

        Db.BoardCards.Remove(card);
        _boardCards.Remove(card);
        await Db.SaveChangesAsync();
        await NormalizeCardOrderAsync(card.Column);
    }

    private async Task EnsureSchemaAsync()
    {
        var connection = Db.Database.GetDbConnection();
        await connection.OpenAsync();
        try
        {
            await EnsureColumnAsync(connection, "TodoItems", "ProjectName");
            await EnsureColumnAsync(connection, "TodoItems", "AssigneeName");
            await EnsureColumnAsync(connection, "BoardCards", "ProjectName");
            await EnsureColumnAsync(connection, "BoardCards", "AssigneeName");
            await EnsureColumnAsync(connection, "Lists", "PeopleJson");
        }
        finally
        {
            await connection.CloseAsync();
        }
    }

    private static async Task EnsureColumnAsync(DbConnection connection, string tableName, string columnName)
    {
        await using var checkCommand = connection.CreateCommand();
        checkCommand.CommandText = $"PRAGMA table_info({tableName});";
        await using var reader = await checkCommand.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            var name = reader.GetString(1);
            if (string.Equals(name, columnName, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }
        }

        await using var alterCommand = connection.CreateCommand();
        alterCommand.CommandText = $"ALTER TABLE {tableName} ADD COLUMN {columnName} TEXT";
        await alterCommand.ExecuteNonQueryAsync();
    }

    private async Task InitializeProjectsAsync()
    {
        if (_list is null)
        {
            return;
        }

        _projects = ParseProjects(_list.ProjectName);
        if (_projects.Count == 0)
        {
            _activeProject = null;
            return;
        }

        _activeProject = _projects[0];
        var defaultProject = _projects[0];
        var updated = false;

        if (_list.Type == ListType.Todo)
        {
            foreach (var item in _todoItems.Where(i => string.IsNullOrWhiteSpace(i.ProjectName)))
            {
                item.ProjectName = defaultProject;
                updated = true;
            }
        }
        else
        {
            foreach (var card in _boardCards.Where(c => string.IsNullOrWhiteSpace(c.ProjectName)))
            {
                card.ProjectName = defaultProject;
                updated = true;
            }
        }

        if (updated)
        {
            await Db.SaveChangesAsync();
        }
    }

    private Task InitializePeopleAsync()
    {
        if (_list is null)
        {
            return Task.CompletedTask;
        }

        _people = ParsePeople(_list.PeopleJson);
        return Task.CompletedTask;
    }

