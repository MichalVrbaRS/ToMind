    private async Task HandleProjectKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddProjectAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelAddProject();
        }
    }

    private async Task AddProjectAsync()
    {
        if (_list is null)
        {
            return;
        }

        var project = _newProjectName.Trim();
        if (string.IsNullOrWhiteSpace(project))
        {
            _projectErrorMessage = "Enter a project name.";
            return;
        }

        if (_projects.Any(existing => string.Equals(existing, project, StringComparison.OrdinalIgnoreCase)))
        {
            _projectErrorMessage = "Project already exists.";
            return;
        }

        _projectErrorMessage = null;
        _projects.Add(project);
        _activeProject = project;
        _isAddingProject = false;
        _newProjectName = string.Empty;
        _activeColumnInput = null;
        CancelCardEdit();
        await SaveProjectsAsync();
    }

    private async Task SaveProjectsAsync()
    {
        if (_list is null)
        {
            return;
        }

        _list.ProjectName = _projects.Count == 0 ? null : JsonSerializer.Serialize(_projects);
        await Db.SaveChangesAsync();
    }

    private async Task SavePeopleAsync()
    {
        if (_list is null)
        {
            return;
        }

        _list.PeopleJson = _people.Count == 0 ? null : JsonSerializer.Serialize(_people);
        await Db.SaveChangesAsync();
    }

    private async Task AddPersonIfNewAsync(string? person)
    {
        if (_list is null || string.IsNullOrWhiteSpace(person))
        {
            return;
        }

        if (_people.Any(existing => string.Equals(existing, person, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        _people.Add(person);
        await SavePeopleAsync();
    }

    private bool MatchesActiveProject(string? projectName)
    {
        if (string.IsNullOrWhiteSpace(_activeProject))
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(projectName))
        {
            var defaultProject = _projects.FirstOrDefault();
            return string.Equals(_activeProject, defaultProject, StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(projectName, _activeProject, StringComparison.OrdinalIgnoreCase);
    }

    private static List<string> ParseProjects(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new List<string>();
        }

        var trimmed = value.Trim();
        if (trimmed.StartsWith("[", StringComparison.Ordinal) && trimmed.EndsWith("]", StringComparison.Ordinal))
        {
            var parsed = JsonSerializer.Deserialize<List<string>>(trimmed) ?? new List<string>();
            return parsed
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Select(p => p.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        return new List<string> { trimmed };
    }

    private static List<string> ParsePeople(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new List<string>();
        }

        var trimmed = value.Trim();
        if (trimmed.StartsWith("[", StringComparison.Ordinal) && trimmed.EndsWith("]", StringComparison.Ordinal))
        {
            var parsed = JsonSerializer.Deserialize<List<string>>(trimmed) ?? new List<string>();
            return parsed
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Select(p => p.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        return new List<string> { trimmed };
    }

    private static string? NormalizeAssignee(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private async Task NormalizeCardOrderAsync(BoardColumn column)
    {
        var cards = GetOrderedCards(column);
        UpdateCardSortOrders(cards);
        await Db.SaveChangesAsync();
    }

    private static void UpdateCardSortOrders(IReadOnlyList<BoardCard> cards)
    {
        for (var i = 0; i < cards.Count; i++)
        {
            cards[i].SortOrder = i;
        }
    }

