@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using ToMind.Data
@using ToMind.Services
@inject ToMindDbContext Db
@inject ListLocalStorage LocalStorage
@inject ListSecurityService Security
@inject NavigationManager Navigation
@inject IWebHostEnvironment HostEnvironment
@inject TopBarState TopBar

<PageTitle>Create List</PageTitle>

<div class="tm-shell">
    <div class="tm-card tm-card-lg">
        @if (_isPreparing)
        {
            <div class="tm-prep">
                <img class="tm-prep-logo" src="images/app-icon.png" alt="ToMind" />
                <h1 class="tm-card-title">Preparing your workspace...</h1>
                <p class="text-muted text-center mb-0">Checking your last opened list.</p>
                <div class="tm-prep-actions">
                    <button class="btn btn-outline-secondary" type="button" @onclick="SkipToCreate">
                        Create new
                    </button>
                    @if (_lastOpenedId is not null && !string.IsNullOrWhiteSpace(_lastOpenedName))
                    {
                        <div class="tm-prep-open">
                            <button class="btn btn-primary" type="button" @onclick="OpenLastList">
                                Open @_lastOpenedName
                            </button>
                            @if (!_skipAutoNav && _autoOpenSecondsLeft > 0)
                            {
                                <span class="tm-prep-countdown">Opening in @_autoOpenSecondsLeft s</span>
                            }
                        </div>
                    }
                </div>
                @if (HasOtherRecentLists())
                {
                    <div class="tm-prep-recent">
                        <div class="tm-prep-recent-title">Recent lists</div>
                        <div class="tm-prep-recent-list">
                            @foreach (var list in _recentLists)
                            {
                                if (_lastOpenedId is not null && list.Id == _lastOpenedId)
                                {
                                    continue;
                                }
                                <button class="btn btn-outline-primary btn-sm" type="button" @onclick="() => OpenRecentList(list.Id)">
                                    @list.Name
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <h1 class="tm-card-title">Create a New List</h1>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger">@_errorMessage</div>
            }

            <EditForm Model="_model" OnValidSubmit="CreateListAsync" FormName="create-list">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label" for="name">List Name</label>
                    <InputText id="name" class="form-control" @bind-Value="_model.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="description">Description (optional)</label>
                    <InputTextArea id="description" class="form-control" @bind-Value="_model.Description" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="image">Image</label>
                    <div class="tm-file-row">
                        <InputFile id="image" class="form-control" OnChange="OnImageSelected" />
                        @if (!string.IsNullOrWhiteSpace(_imageName))
                        {
                            <span class="tm-file-name">@_imageName</span>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Type</label>
                    <InputRadioGroup class="tm-radio-group" @bind-Value="_model.Type">
                        <label class="form-check">
                            <InputRadio class="form-check-input" Value="@ListType.Todo" />
                            <span class="form-check-label">Todo List</span>
                        </label>
                        <label class="form-check">
                            <InputRadio class="form-check-input" Value="@ListType.Board" />
                            <span class="form-check-label">Kanban Board</span>
                        </label>
                    </InputRadioGroup>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="project">Projects</label>
                    <input id="project" class="form-control" placeholder="Type a project name and press Enter"
                           @bind="_projectInput" @bind:event="oninput" @onkeydown="HandleProjectKeyDown" />
                    @if (_model.Projects.Count > 0)
                    {
                        <div class="tm-project-chips">
                            @foreach (var project in _model.Projects)
                            {
                                <span class="tm-project-chip">
                                    @project
                                    <button class="tm-chip-remove" type="button" title="Remove project" @onclick="() => RemoveProject(project)">×</button>
                                </span>
                            }
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">People</label>
                    <input class="form-control" placeholder="Type a name and press Enter"
                           @bind="_personInput" @bind:event="oninput" @onkeydown="HandlePersonKeyDown" />
                    @if (_model.People.Count > 0)
                    {
                        <div class="tm-project-chips">
                            @foreach (var person in _model.People)
                            {
                                <span class="tm-project-chip">
                                    @person
                                    <button class="tm-chip-remove" type="button" title="Remove person" @onclick="() => RemovePerson(person)">×</button>
                                </span>
                            }
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="_model.ProtectWithPassword" />
                        <span class="form-check-label">Protect with password</span>
                    </label>
                </div>

                @if (_model.ProtectWithPassword)
                {
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="confirmPassword">Confirm Password</label>
                        <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="_model.ConfirmPassword" />
                    </div>
                }

                <button class="btn btn-primary w-100" type="submit" disabled="@_isSubmitting">
                    Create
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    private const long MaxImageBytes = 5 * 1024 * 1024;
    private const int AutoOpenDelaySeconds = 5;
    private readonly CreateListModel _model = new();
    private IBrowserFile? _imageFile;
    private string? _imageName;
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _isPreparing = true;
    private Guid? _lastOpenedId;
    private string? _lastOpenedName;
    private bool _skipAutoNav;
    private int _autoOpenSecondsLeft;
    private List<MindList> _recentLists = new();
    private string _projectInput = string.Empty;
    private bool _suppressSubmit;
    private string _personInput = string.Empty;

    protected override void OnInitialized()
    {
        TopBar.Set("ToMind", false, false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var forceNew = query.TryGetValue("new", out var value) && value == "1";

        await Db.Database.EnsureCreatedAsync();
        await EnsurePeopleSchemaAsync();
        var recentIds = (await LocalStorage.GetRecentOpenedListIdsAsync()).ToList();
        if (recentIds.Count == 0)
        {
            var legacyLastOpened = await LocalStorage.GetLastOpenedListIdAsync();
            if (legacyLastOpened is not null)
            {
                await LocalStorage.SetLastOpenedListIdAsync(legacyLastOpened.Value);
                recentIds = (await LocalStorage.GetRecentOpenedListIdsAsync()).ToList();
            }
        }

        _recentLists = new List<MindList>();
        if (recentIds.Count > 0)
        {
            var recentLists = await Db.Lists.AsNoTracking()
                .Where(l => recentIds.Contains(l.Id))
                .ToListAsync();
            var lookup = recentLists.ToDictionary(l => l.Id);
            foreach (var id in recentIds)
            {
                if (lookup.TryGetValue(id, out var list))
                {
                    _recentLists.Add(list);
                }
            }
        }

        if (_recentLists.Count > 0)
        {
            _lastOpenedId = _recentLists[0].Id;
            _lastOpenedName = _recentLists[0].Name;
        }
        else
        {
            _lastOpenedId = null;
            _lastOpenedName = null;
        }

        _autoOpenSecondsLeft = (!forceNew && _lastOpenedId is not null) ? AutoOpenDelaySeconds : 0;

        StateHasChanged();
        if (forceNew || _lastOpenedId is null)
        {
            _isPreparing = false;
            StateHasChanged();
            return;
        }

        for (var remaining = AutoOpenDelaySeconds; remaining > 0; remaining--)
        {
            if (_skipAutoNav)
            {
                return;
            }

            _autoOpenSecondsLeft = remaining;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1000);
        }

        if (_skipAutoNav)
        {
            return;
        }

        Navigation.NavigateTo($"/{_lastOpenedId}");
        return;
    }

    private bool HasOtherRecentLists()
    {
        if (_recentLists.Count == 0)
        {
            return false;
        }

        if (_lastOpenedId is null)
        {
            return true;
        }

        return _recentLists.Any(list => list.Id != _lastOpenedId.Value);
    }

    private void SkipToCreate()
    {
        _skipAutoNav = true;
        _autoOpenSecondsLeft = 0;
        _isPreparing = false;
        StateHasChanged();
    }

    private void OpenLastList()
    {
        if (_lastOpenedId is null)
        {
            return;
        }

        _skipAutoNav = true;
        _autoOpenSecondsLeft = 0;
        Navigation.NavigateTo($"/{_lastOpenedId}");
    }

    private void OpenRecentList(Guid listId)
    {
        _skipAutoNav = true;
        _autoOpenSecondsLeft = 0;
        Navigation.NavigateTo($"/{listId}");
    }

    private void OnImageSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _errorMessage = "Please select an image file.";
            _imageFile = null;
            _imageName = null;
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            _errorMessage = $"Image must be {MaxImageBytes / (1024 * 1024)} MB or smaller.";
            _imageFile = null;
            _imageName = null;
            return;
        }

        _errorMessage = null;
        _imageFile = file;
        _imageName = file.Name;
    }

    private async Task CreateListAsync()
    {
        if (_suppressSubmit)
        {
            _suppressSubmit = false;
            return;
        }

        if (_isSubmitting)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            return;
        }

        if (_model.ProtectWithPassword)
        {
            if (string.IsNullOrWhiteSpace(_model.Password))
            {
                _errorMessage = "Password is required.";
                return;
            }

            if (!string.Equals(_model.Password, _model.ConfirmPassword, StringComparison.Ordinal))
            {
                _errorMessage = "Passwords do not match.";
                return;
            }
        }

        _isSubmitting = true;
        try
        {
            AddProjectFromInput();
            AddPersonFromInput();
            var projects = _model.Projects;
            var people = _model.People;
            var now = DateTime.UtcNow;
            var list = new MindList
            {
                Id = Guid.NewGuid(),
                Name = _model.Name.Trim(),
                Description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim(),
                Type = _model.Type,
                ProjectName = projects.Count == 0 ? null : JsonSerializer.Serialize(projects),
                PeopleJson = people.Count == 0 ? null : JsonSerializer.Serialize(people),
                CreatedAtUtc = now,
                UpdatedAtUtc = now
            };

            if (_model.ProtectWithPassword && !string.IsNullOrWhiteSpace(_model.Password))
            {
                list.PasswordHash = Security.HashPassword(list, _model.Password);
            }

            if (_imageFile is not null)
            {
                list.ImagePath = await SaveImageAsync(_imageFile);
            }

            EnsureAppDataDirectory();
            await Db.Database.EnsureCreatedAsync();
            Db.Lists.Add(list);
            await Db.SaveChangesAsync();

            await LocalStorage.SetLastOpenedListIdAsync(list.Id);
            Navigation.NavigateTo($"/{list.Id}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task<string> SaveImageAsync(IBrowserFile file)
    {
        var uploadsRoot = Path.Combine(HostEnvironment.WebRootPath, "uploads");
        Directory.CreateDirectory(uploadsRoot);

        var extension = Path.GetExtension(file.Name);
        var fileName = $"{Guid.NewGuid():N}{extension}";
        var filePath = Path.Combine(uploadsRoot, fileName);

        await using var stream = file.OpenReadStream(MaxImageBytes);
        await using var target = File.Create(filePath);
        await stream.CopyToAsync(target);

        return $"uploads/{fileName}";
    }

    private void EnsureAppDataDirectory()
    {
        var appDataRoot = Path.Combine(HostEnvironment.ContentRootPath, "App_Data");
        Directory.CreateDirectory(appDataRoot);
    }

    private async Task EnsurePeopleSchemaAsync()
    {
        var connection = Db.Database.GetDbConnection();
        await connection.OpenAsync();
        try
        {
            await EnsureColumnAsync(connection, "Lists", "PeopleJson");
        }
        finally
        {
            await connection.CloseAsync();
        }
    }

    private static async Task EnsureColumnAsync(DbConnection connection, string tableName, string columnName)
    {
        await using var checkCommand = connection.CreateCommand();
        checkCommand.CommandText = $"PRAGMA table_info({tableName});";
        await using var reader = await checkCommand.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            var name = reader.GetString(1);
            if (string.Equals(name, columnName, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }
        }

        await using var alterCommand = connection.CreateCommand();
        alterCommand.CommandText = $"ALTER TABLE {tableName} ADD COLUMN {columnName} TEXT";
        await alterCommand.ExecuteNonQueryAsync();
    }

    private void AddProjectFromInput()
    {
        var project = _projectInput.Trim();
        if (string.IsNullOrWhiteSpace(project))
        {
            return;
        }

        if (_model.Projects.Any(existing => string.Equals(existing, project, StringComparison.OrdinalIgnoreCase)))
        {
            _projectInput = string.Empty;
            return;
        }

        _model.Projects.Add(project);
        _projectInput = string.Empty;
    }

    private void RemoveProject(string project)
    {
        _model.Projects.Remove(project);
    }

    private void HandleProjectKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _suppressSubmit = true;
            AddProjectFromInput();
        }
    }

    private void AddPersonFromInput()
    {
        var person = _personInput.Trim();
        if (string.IsNullOrWhiteSpace(person))
        {
            return;
        }

        if (_model.People.Any(existing => string.Equals(existing, person, StringComparison.OrdinalIgnoreCase)))
        {
            _personInput = string.Empty;
            return;
        }

        _model.People.Add(person);
        _personInput = string.Empty;
    }

    private void RemovePerson(string person)
    {
        _model.People.Remove(person);
    }

    private void HandlePersonKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _suppressSubmit = true;
            AddPersonFromInput();
        }
    }

    private sealed class CreateListModel
    {
        [Required]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public ListType Type { get; set; } = ListType.Todo;

        public List<string> Projects { get; } = new();
        public List<string> People { get; } = new();

        public string? Password { get; set; }

        public string? ConfirmPassword { get; set; }

        public bool ProtectWithPassword { get; set; }
    }
}
